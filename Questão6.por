programa {
  funcao inicio() {
    inteiro numero
    inteiro contador
    inteiro resultado
escreva("\nDigite um número: ")
leia (numero)
contador = 1
enquanto(numero e contador <=10){
resultado = numero * contador
escreva(numero, " x ", contador, " = ", resultado, "\n")
contador = contador + 1
}
  }
}
